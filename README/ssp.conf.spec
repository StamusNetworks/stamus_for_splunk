[config]
api_key = <value>
* The user token generated on Clear NDR.

base_url = <value>
* The base URL of Clear NDR.

check_tls = <value>
* A boolean (yes|no) to indicate if TLS certificates should be checked when connecting to Clear NDR.

tenant = <value>
* The tenant name to connect to in Clear NDR. If not set, no tenant will be used.

license_key = <value>
* The license key to use for Clear NDR. It is used to fetch Newly Registered Domain (NRD). If not set, NRD will not be used.
